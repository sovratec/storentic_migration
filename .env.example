DB_HOST=localhost
DB_PORT=5432
DB_NAME=storentic
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Organization and Location context (required — not in Excel source)
ORGANIZATION_ID=1
LOCATION_ID=1

# ID of the user account that owns this migration run (written to created_by / updated_by)
CREATED_BY=1

# Migration settings
DRY_RUN=false
UPDATE_EXISTING=false

# Payment migration settings (migrate_payments.py)
# Number of payment rows committed per DB transaction (default: 500)
BATCH_SIZE=500
